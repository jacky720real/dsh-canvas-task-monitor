{
  "name": "dsh-canvas-task-monitor",
  "version": "1.2.0",
  "description": "Canvas 学习任务监控插件：拉取 Canvas（可选邮箱）→ 变更检测 → 规则/AI 评分 → 在 DSH 主区域面板与左上侧边栏「待办」入口显示任务清单。自包含、零运行时依赖。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jacky720real/dsh-canvas-task-monitor.git"
  },
  "homepage": "https://github.com/Jacky720real/dsh-canvas-task-monitor#readme",
  "bugs": {
    "url": "https://github.com/Jacky720real/dsh-canvas-task-monitor/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "canvas",
    "lms",
    "todo",
    "task-monitor"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.5"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.1.5-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.0-rc.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
